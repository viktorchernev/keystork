{
  "manifest_version": 3,
  "name": "Keystork",
  "version": "1.0.0",
  "description": "Keyboard controls for HTML5 video players.",
  "icons": {
    "96": "icon.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_icon": {
      "96": "icon.png"
    },
    "default_title": "Keystork"
  },
  "content_scripts": [
    {
      "matches": [
        "*://xvideos.com/*", "*://*.xvideos.com/*",
		"*://xnxx.com/*", "*://*.xnxx.com/*"
      ],
      "js": [
        "keystork.js"
      ],
      "run_at": "document_idle"
    }
  ]
}